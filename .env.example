# Set these in Dokploy's Environment tab, not in a file on the server.

# === Required (all modes) ===

# openssl rand -hex 32
JWT_SECRET=REPLACE-ME

# Bootstrap password for the dashboard. 9router defaults this to 123456 when
# unset, so the Headscale compose file refuses to deploy without it. Once you
# set a password in the UI it is bcrypt-hashed into SQLite and takes precedence.
INITIAL_PASSWORD=REPLACE-ME

# === Tailscale mode (docker-compose.yml) ===

# Reusable, non-ephemeral, tagged tag:nine-router. Consumed once on first
# run; after that the node identity lives in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# === Headscale mode (docker-compose.headscale.yml) ===

# Public hostname of your Headscale control plane. Traefik terminates TLS.
HEADSCALE_DOMAIN=headscale.example.com

# Empty when the certificate for HEADSCALE_DOMAIN is uploaded in Dokploy
# (e.g. a Cloudflare Origin certificate). "letsencrypt" for Dokploy's ACME.
# CERT_RESOLVER=

# Set true and redeploy to print a single-use key for the Devices user,
# valid 1 hour. Set back to false once your device has joined.
NEW_DEVICE=false

# Space-separated node IDs to delete on the next deploy. IDs are printed in
# the headscale container log on every start. Empty it again afterwards.
DELETE_NODE_IDS=

# === Image overrides (optional) ===
# The Headscale compose file pins every image. Bump these deliberately after
# reading the release notes; an unreviewed 9router image can read your
# provider tokens.
# NINEROUTER_IMAGE=decolua/9router:0.5.75
# TAILSCALE_IMAGE=tailscale/tailscale:v1.102.3
# HEADSCALE_IMAGE=headscale/headscale:0.29.3-debug
# HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom@sha256:...

# Tailscale mode only. Default: 9router / tag:nine-router
# TAILSCALE_HOSTNAME=9router
# TAILSCALE_TAG=tag:nine-router
