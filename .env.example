# Set these in Dokploy's Environment tab, not in a file on the server.

# === Required (all modes) ===

# openssl rand -hex 32
JWT_SECRET=REPLACE-ME

# Bootstrap password for the dashboard. 9router defaults this to 123456 when
# unset, so the Headscale compose file refuses to deploy without it. Once you
# set a password in the UI it is bcrypt-hashed into SQLite and takes precedence.
INITIAL_PASSWORD=REPLACE-ME

# === Tailscale mode (docker-compose.yml) ===

# Reusable, non-ephemeral, tagged tag:nine-router. Consumed once on first run;
# after that the node identity lives in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# === Headscale mode (docker-compose.headscale.yml): joins your own Headscale control plane ===

# Public name of your Headscale control plane. The login server is always
# https://<HUB_DOMAIN>.
HUB_DOMAIN=hub.example.com

# Single-use pre-auth key tagged tag:nine-router, minted on your Headscale
# control plane and valid one hour, so mint it right before the deploy. This is the same variable name as in
# Tailscale mode but a different kind of key (hskey-auth-, not tskey-auth-).
# It is used only on the first start; afterwards leave the spent value in
# place, because the compose file fails the deploy when it is empty.
# TS_AUTHKEY=hskey-auth-REPLACE-ME
#
# Control-plane operations (devices, policy, keys, deleting nodes) belong to
# the control plane, not this stack.

# === Image overrides (optional) ===
# The Headscale compose file pins every image. Bump these deliberately after
# reading the release notes; an unreviewed 9router image can read your
# provider tokens.
# Set a specific published 9Router version here, then redeploy in Dokploy.
# This overrides the default image in every access mode.
# NINEROUTER_IMAGE=decolua/9router:0.5.75
# Headscale mode: keep this on your control plane's Tailscale client line
# (currently v1.102.4).
# TAILSCALE_IMAGE=tailscale/tailscale:v1.102.4
# HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom@sha256:...

# Tailscale mode only. Default: 9router / tag:nine-router
# TAILSCALE_HOSTNAME=9router
# The mesh name is 9router; the tag is spelled out because Tailscale and
# Headscale require tag names to start with a letter (tag:9router is rejected).
# TAILSCALE_TAG=tag:nine-router
