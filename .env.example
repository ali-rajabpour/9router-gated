# Set these in Dokploy's Environment tab, not in a file on the server.
# All values have sensible defaults - only set the ones you want to change.

# === Required (all modes) ===

# openssl rand -hex 32
JWT_SECRET=REPLACE-ME

# Bootstrap password for the dashboard. 9router defaults this to 123456 when
# unset. Once you set a password in the UI it is bcrypt-hashed into SQLite
# and takes precedence over this value.
INITIAL_PASSWORD=REPLACE-ME

# === Tailscale mode (docker-compose.yml) ===

# Reusable, non-ephemeral, tagged tag:nine-router. Consumed once on first
# run; after that the node identity lives in the tailscale-state volume.
# Omit entirely in SSH and Headscale modes.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# === Headscale mode (docker-compose.headscale.yml) ===

# Your Headscale control plane's public hostname. Traefik terminates TLS.
# This is substituted into the Headscale config at container startup - no
# file editing needed.
HEADSCALE_DOMAIN=headscale.example.com

# Headscale pre-auth key. Generate with:
#   docker exec <headscale-container> headscale users create <user>
#   docker exec <headscale-container> headscale preauthkeys create --user <user>
# This is NOT a Tailscale key. Omit in Tailscale and SSH modes.
HS_AUTHKEY=REPLACE-ME

# === Image versions (all modes, optional) ===
# Defaults track :latest. Pin a specific tag to control updates and avoid
# upstream compromises reaching your provider tokens without review.

# 9Router image. Default: decolua/9router:latest
# NINEROUTER_IMAGE=decolua/9router:0.5.75

# Tailscale sidecar image. Default: tailscale/tailscale:latest
# TAILSCALE_IMAGE=tailscale/tailscale:v1.66.0

# Headscale control plane image. Default: headscale/headscale:0.29.3
# HEADSCALE_IMAGE=headscale/headscale:0.29.3

# Headroom image. Default: ghcr.io/chopratejas/headroom:latest
# HEADROOM_IMAGE=ghcr.io/chopratejas/headroom:latest

# === Tailscale/Headscale sidecar options (optional) ===

# Hostname for the sidecar node in the mesh. Default: 9router
# TAILSCALE_HOSTNAME=9router

# Tailscale tag for ACL routing. Default: tag:nine-router
# TAILSCALE_TAG=tag:nine-router
